{
  "name": "simple-site-0722",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "node scripts/local-runtime.mjs dev",
    "build": "node scripts/build.mjs",
    "start": "node scripts/local-runtime.mjs start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:http": "node scripts/http-journey.mjs",
    "validate:artifact": "node --experimental-loader ./scripts/cloudflare-workers-loader.mjs ./scripts/validate-artifact.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/local-db.mjs migrate",
    "db:status": "node scripts/local-db.mjs status",
    "db:backup": "node scripts/local-db.mjs backup",
    "db:reset": "node scripts/local-db.mjs reset"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "katex": "^0.18.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/katex": "^0.16.8",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "sharkdingo 的知识花园"
}
